{
  "name": "financial-ponds-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:data": "npm run fp:model",
    "build:site": "bash scripts/build-site.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "validate:data": "node scripts/validate-published-data.mjs",
    "validate:history-quality": "node scripts/build-market-history-quality.mjs --strict",
    "test": "node --test tests/*.test.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "deploy": "npm run build:site && npm run validate && npm run validate:data && npx wrangler@4.102.0 deploy",
    "fp:collect": "node scripts/fp/run-stage.mjs collect",
    "fp:normalize": "node scripts/fp/run-stage.mjs normalize",
    "fp:observe": "node scripts/fp/run-stage.mjs observe",
    "fp:assess": "node scripts/fp/run-stage.mjs assess",
    "fp:penetrate": "node scripts/fp/run-stage.mjs penetrate",
    "fp:decide": "node scripts/fp/run-stage.mjs decide",
    "fp:review": "node scripts/fp/run-stage.mjs review",
    "fp:validate": "node scripts/fp/run-stage.mjs validate",
    "fp:persist": "node scripts/fp/run-stage.mjs persist",
    "fp:publish": "node scripts/fp/run-stage.mjs publish",
    "fp:model": "node scripts/fp/run-model.mjs",
    "fp:daily": "node scripts/fp/run-daily.mjs",
    "fp:replay": "node scripts/fp/run-replay.mjs",
    "fp:audit": "node scripts/fp/run-stage.mjs audit",
    "fp:breadth": "node scripts/build-sector-breadth.mjs",
    "fp:research": "node scripts/build-market-penetration-ai.mjs",
    "fp:backfill": "node scripts/local/fp-backfill.mjs",
    "fp:today": "node scripts/fp/run-today.mjs",
    "fp:summary": "node scripts/local/fp-progress-summary.mjs",
    "benchmark:archive": "node scripts/apply-benchmark-to-archives.mjs",
    "history:snapshot": "node scripts/build-daily-longitudinal-archive.mjs",
    "history:labels": "node scripts/build-daily-outcome-label-ledger.mjs",
    "history:coverage": "node scripts/history-cli.mjs coverage",
    "history:inspect": "node scripts/history-cli.mjs inspect",
    "history:compare": "node scripts/history-cli.mjs compare",
    "history:import-committed": "node scripts/import-committed-historical-snapshots.mjs"
  },
  "devDependencies": {
    "wrangler": "4.102.0"
  },
  "version": "0.10.78"
}
